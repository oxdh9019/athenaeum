# V0.7 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== API Keys ====================
# MiniMax API Key（用于云端 LLM 调用）
# 获取地址: https://platform.minimaxi.com/
ANTHROPIC_API_KEY=
MINIMAX_API_KEY=

# ==================== 服务配置 ====================
# 是否仅使用本地 Ollama（不调用云端）
USE_OLLAMA=1

# Ollama 地址
OLLAMA_BASE_URL=http://localhost:11434

# Chroma 地址
CHROMA_BASE_URL=http://localhost:8000

# ==================== 模型配置 ====================
# 本地模型名称
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBED_MODEL=bge-m3

# ==================== 成本控制 ====================
# 每日预算（美元）
DAILY_BUDGET=10.0

# ==================== 路由降级阈值 ====================
# 预算使用超过此比例时启用降级
DEGRADE_THRESHOLD=0.8
# 预算使用超过此比例时即使附身也降级
EMERGENCY_THRESHOLD=0.95